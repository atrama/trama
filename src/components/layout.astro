   :global(html){
    font-size:20px;
   }
:global(body){
  margin: 0;
  padding: 0 1.5%;
  color:var(--main);
  line-height: 1.7;
  font-family: var(--fontBody);
  /* //sticky footer
  display: flex;
  flex-direction: column;
  min-height: 100vh; */
}

header{
  margin:.5rem 0 0;
  padding: .25rem 0;
  border-bottom: .15rem solid var(--main);
  display: flex;
  align-items: baseline;

  h1{
    margin:0;
    font-size:1rem;
    flex: 2 5 5rem;
  }

  a{
    color:inherit;
    text-decoration: none;
    font-weight: 700;
  }
}

.mainNav{
  margin-left:auto;
  text-align: right;
  flex: 4 1 auto;
}

:global(h1, h2, h3){
  font-family: var(--fontHeading);
  text-transform: uppercase;
  font-weight: 900;
  line-height: 1.4;
}

:global(h1){
  font-size:4rem;
}

:global(p){
  line-height: 1.7;
}

:global(a){
  color:var(--blue);
  filter:brightness(100%);
  text-decoration: none;
  transition:.5s filter ease-in-out;

  &:hover{
    text-decoration: underline;
    filter:brightness(5%);
  }
}
  /* --breakpoint-xs: 450px;
    --sm: 701px;
    --md: 1101px;
    --lg: 1401px; */

@media (min-width: 450px) {
  header h1 {
    flex: 1 1 8rem;
  }
  .mainNav a:not(:first-of-type){
    padding-left: 1rem;
  }
}

@media (min-width: 701px) {
	body {
		padding: 0 5%;
	}
}

@media (min-width: 1001px) {
  header{
    margin-bottom: 2rem;
  }
}
  
@media (min-width: 1401px) {
	body {
		padding: 0 10%;
	}
}
</style>
