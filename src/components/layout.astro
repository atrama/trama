    <footer class="site-footer">


<h2 class="footerHeading">Anthony Trama</h2>
<ul class="social">
  <li>
    <a href="https://github.com/atrama" title="github"><span class="icon icon--github"><GithubIcon /></span></a>
  </li>
  <li>
