</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  html {
    font-size: clamp(16px, 2vw, 20px);
  }
  body {
    margin: 0;
    padding: 0;
    color: var(--color-main);
    background: var(--color-main-contrast);
    line-height: 1.7;
    font-family: var(--fontBody);
  }
  main {
    container-type: inline-size;
    padding-inline: var(--page-gutter);
  }
</style>

<style>
header{
  margin: .5rem 0 0;
  padding-inline: var(--page-gutter);
  border-bottom: .15rem solid var(--color-main);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;

  h1{
    margin:0;
    font-size: clamp(1rem, 2vw, 1.5rem);
  }

  a{
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }
}

.mainNav{
  text-align: right;

  a:not(:first-of-type){
      padding-left: clamp(10px, 1rem, 2.5rem);
    }
}

footer {
  margin-top: 2rem;
  padding: .5rem var(--page-gutter);
  border-top: solid 0.4rem var(--color-main);  border-top: solid .4rem var(--color-main);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;

  h2 {
    margin:0;
    font-size: clamp(1rem, 4vw, 3.5rem);
  }

  ul{
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 1rem;

    li{
      width: clamp(20px, 2rem, 40px);
    }
  }

  svg{
    fill: var(--color-main);
  }
}

:global(h1, h2, h3){
  font-family: var(--fontHeading);
  text-transform: uppercase;
  font-weight: 900;
  line-height: 1.4;
}

:global(h1){
  font-size: clamp(2rem, 8vw, 4rem);
}

:global(p){
  line-height: 1.7;
}

:global(a){
  color: var(--color-accent);
  filter: brightness(100%);
  text-decoration: none;
  transition: filter 0.5s ease-in-out;
}

:global(a:hover){
  text-decoration: underline;
  filter: brightness(80%);
}

@media (prefers-reduced-motion: reduce) {
  :global(a) {
    transition: none;
  }
}

</style>
