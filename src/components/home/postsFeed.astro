---
import { XMLParser } from 'fast-xml-parser';
import mockPosts from '../../mocks/posts.js'

interface Post {
  title: string;
  url: string;
  date: string;
}
const isDev = import.meta.env.DEV;

const determinePostSource = async (devEnv: boolean) => {
  if (devEnv) {
    return mockPosts;
  }
  const response = await fetch('https://medium.com/feed/@anthonytrama');
  const responseText = await response.text();
  const data = new XMLParser().parse(responseText).rss.channel.item;
  return data;
};

const fetchPosts = async () => {
  try {
    const data = await determinePostSource(isDev);
    const posts: Post[] = data.map((item: any) => ({
      title: item.title,
      url: item.link,
      date: new Date(item.pubDate).toLocaleDateString('en-US'),
    }));
    return posts;
  } catch (error) {
    return [];
  }
}; 


const posts: Post[] = await fetchPosts();
---
<div class="posts">
  {posts.length > 1 ? posts.map((post) => (
      <article>
        <h1>
          <a href={post.url}>{post.title}</a>
        </h1>
        <p class="post-meta">{post.date}</p>
      </article>
  )) : (
    <p>
      View my writing on{' '}
      <a href="https://medium.com/@anthonytrama">Medium</a>
    </p>
  )}
</div>

<style>
.posts{
  padding-block-end: 4vw;
}

article{
    padding:1rem;
    position: relative;
    display:grid;
    grid-template-rows: repeat(2, auto);
    grid-template-areas:
      "meta"
      "article";

  a {
    color: light-dark(var(--color-link), var(--color-main));
  }
  
  h1{
    grid-column: 1 / 3;
    margin: 0;
    font-size:clamp(1rem, 1.9rem, 3.25vw);
    text-transform: none;
  }
}

article:not(:last-of-type)::after {
  content: "";
  position: absolute;
  inset-inline-start: 15%;
  inset-block-end: 0;
  width: 70%;
  border-block-end: 1px solid var(--color-main);
}


.post-meta {
  margin-block-end: 0;
  font-size:.8rem;
}

@container (width >= 500px) {  

  .post-meta {
    font-size:1rem;
    grid-area: meta;
  }
}
</style>