    /* keyframes: right -> left -> right */
@keyframes slide-rl {
    from,
  60%,
  75%,
  90%,
  to {
    animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  0%   { transform: translateX(0);     }
  14%  { transform: translateX(-100%); }
  17%  { transform: translateX(-90%); }
  20%  { transform: translateX(-100%); }
  22%  { transform: translateX(-95%); }
  24%  { transform: translateX(-100%); }
  60%  { transform: translateX(-102%); }
  100% { transform: translateX(0);     }
}


/* respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .postHeadingContainer h1.animate,
  .postHeadingContainer h1 {
    animation: none;
    transition: none;
  }
}


  /* --breakpoint-xs: 450px;
    --sm: 701px;
    --md: 1101px;
    --lg: 1401px; */

.postHeadingContainer{
  text-align: right;
  h1{
    margin-bottom: .75rem;
    padding: .25em 1em 0;
    display: inline-block;
    font-size:2.5rem;
    color:white;
    text-align: center;
    background: var(--green);
    will-change: transform;

    @container (width>= 701px) {
      font-size:4.5rem;
      &.animate {
        color:red;
        animation: slide-rl 6s 1 cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
      }
    }

    @include mq ($size:sm){
      font-size:3rem;
    }

    @include mq ($size:md){
      font-size:4rem;
    }
    &:after{
      width: 100%;
      border-width: 0 .65em .25em;
      border-style: solid;
      border-color: var(--green) transparent;
      display: block;
      content: "";
    }
  }

  .allPosts{
    margin:0 2%;
    text-align: right;
  }
}

.postsContainer{
  container-type: inline-size;
}

.posts{
  display:grid;
  grid-template-columns: minmax(30rem, 60rem);
  column-gap: 1rem;
  row-gap: 1rem;
  grid-gap: 1rem;

  article{
    margin-bottom: 2rem;
    padding:2rem;
    box-shadow: 0 0 1.25rem .15rem var(--grayTrans);
    background: #fff;
  }

  article h1{
    margin: 0;
    font-size:1.5rem;

  }
}


@media (min-width: 1101px) {
  .posts{
    display: flex;
    flex-wrap: wrap;

    article{
      flex:1 1 44%;
      margin: 1rem 2% 1rem;
    }
  }
}


@media (min-width: 1401px) {
  .posts article{
      padding:.75rem 1rem;
    }
}


.post-meta {
  margin-top: .25rem;
  font-size:.85rem;
}

</style>