</section>

<script>

if(typeof window !== 'undefined' && 'IntersectionObserver' in window){
  const heading = document.getElementById('postsHeading');
  if(heading){
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if(entry.isIntersecting){
          heading.classList.remove('animate');
          heading.classList.add('animate');
        }else{
          heading.classList.remove('animate');
        }
      });
    }, {
      threshold: [0.0, 0.25, 0.5, 0.75, 1.0],
      rootMargin: '0px 0px -10% 0px'
    });
    observer.observe(heading);
  }
}
</script>

<style>
@keyframes slide-rl {
  from,
  60%,
  75%,
  90%,
  to {
    animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  0%   { transform: translateX(0);     }
  14%  { transform: translateX(-100%); }
  17%  { transform: translateX(-90%); }
  20%  { transform: translateX(-100%); }
  22%  { transform: translateX(-95%); }
  24%  { transform: translateX(-100%); }
  60%  { transform: translateX(-102%); }
  100% { transform: translateX(0);     }
}

/* respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .postHeadingContainer h1.animate,
  .postHeadingContainer h1 {
    animation: none;
    transition: none;
  }
}


/* --breakpoint-xs: 450px;
  --sm: 701px;
  --md: 1101px;
  --lg: 1401px; */

.postsContainer{
  container-type: inline-size;
}


.postHeadingContainer{
  text-align: right;
  h1{
    margin-bottom: .75rem;
    padding: .25em 1em 0;
    display: inline-block;
    font-size:2.5rem;
    color:var(--color-text-accent);
    background: var(--color-highlight);
    will-change: transform;

    @container (width>= 701px) {
      font-size:4.5rem;
      &.animate {
        animation: slide-rl 6s 1 cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
      }
    }

    &:after{
      width: 100%;
      border-width: 0 .65em .25em;
      border-style: solid;
      border-color: var(--color-highlight) transparent;
      display: block;
      content: "";
    }
  }
}

.allPosts{
  margin:0 0 1rem;
  text-align: right;
}

@media (min-width: 1101px) {
  .posts{
    display: flex;
    flex-wrap: wrap;

    article{
      flex:1 1 44%;
      margin: 1rem 2% 1rem;
    }
  }
}


@media (min-width: 1401px) {
  .posts article{
      padding:.75rem 1rem;
    }
}


.post-meta {
  margin-top: .25rem;
  font-size:.85rem;
}

</style>