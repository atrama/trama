---
import Layout from '../components/layout.astro'
import Contact from '../components/home/contact.astro'
import Posts from '../components/home/posts.astro'
import { Picture } from 'astro:assets'
import { Image } from 'astro:assets';
import anthony from '../img/anthony.jpeg'
import '../style/var.css'

const pageInfo = {
	title: "Anthony Trama",
	heading : "Hi, I'm Anthony",
}
---
<Layout>
		<Posts/>

	<section class="about">
		<!-- <Image src={anthony} alt="Photo of a man in a hat smiling" /> -->

		<Picture src={anthony} formats={['webp', 'jpeg']} alt="Photo of a man in a hat smiling" />
		<h1>{pageInfo.heading}</h1>
		<div class="content">
			<p>I live in San Diego and have been making websites since...well, a long time ago. I lead a Front End Team that has a lot of amazing people spread out across the USA.</p>
			<p>When I'm not working, I can be found in the garage building custom furniture, playing drums, walking my old lab who still thinks he's a puppy, or on the field coaching my two sons.</p>
			<p>Take a look at what I'm <a href="https://medium.com/@anthonytrama">writing</a> or just <a href="#contact">say "hi"</a>.</p>
		</div>	
	</section>
	<!-- <Contact /> -->
</Layout>

<style>

.about{
	display: grid;
	align-items: center;
	grid-template-columns: 1fr minmax(50%, 65%);
	grid-gap:1rem;
	grid-template-areas: 
		"picture heading"
		"content content";
	padding-top: 1.5rem;
	container-name: about;
	container-type: inline-size;
	}

	h1 {
	grid-area: heading;
	margin: 0.5rem 0 0;
	color: var(--green);
	font-size: 10vw;
	}
 
	@container about (min-width: 300px) {
  		h1 {
    		font-size: clamp(3rem, 100cqw / 8, 9.5vw);
  		}
	}

	.content {
		grid-area: content;
	}
  
	@media (min-width: 701px) {
	  .about {
		padding-bottom: 1.5rem;
		grid-template-areas: 
			"heading heading"
			"picture content";
		}
	}

  
	picture {
		grid-area:picture;
  
	  img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 100%;
		/* AR used in place of image width/height to avoid layout shifts */
		aspect-ratio:1/1
	  }
	}
</style>